<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/evidence_dock_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:background="#161B22">
    <TextView
        android:id="@+id/evidence_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#7ED7DF"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:labelFor="@id/terminal_toolbar_stacked_text_input" />
    <EditText
        android:id="@+id/terminal_toolbar_stacked_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:maxLines="4"
        android:maxLength="16384"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:imeOptions="flagNoFullscreen|flagNoEnterAction"
        android:importantForAutofill="no"
        android:saveEnabled="false"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0BEC5"
        android:textSize="15sp"
        android:hint="@string/evidence_hint" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/evidence_attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <Button android:id="@+id/evidence_add_files" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/evidence_files" android:textAllCaps="false" />
            <Button android:id="@+id/evidence_insert" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/evidence_insert" android:textAllCaps="false" />
            <Button android:id="@+id/evidence_send" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/evidence_send" android:textAllCaps="false" />
            <Button android:id="@+id/evidence_more" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/evidence_more" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
